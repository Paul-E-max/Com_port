<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ThorlabsPowerMeterApp</RootNamespace>
    <AssemblyName>ThorlabsPowerMeterApp</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Thorlabs.TLPM_64.Interop">
      <HintPath>C:\Program Files\IVI Foundation\VISA\VisaCom64\Primary Interop Assemblies\Thorlabs.TLPM_64.Interop.dll</HintPath>
    </Reference>
    <Reference Include="Thorlabs.TLPMX_64.Interop">
      <HintPath>C:\Program Files\IVI Foundation\VISA\VisaCom64\Primary Interop Assemblies\Thorlabs.TLPMX_64.Interop.dll</HintPath>
    </Reference>
    <Reference Include="System.Management" />
  </ItemGroup>

  <!-- Copy native Thorlabs DLLs to output -->
  <ItemGroup>
    <Content Include="..\ThorLabs\ThorLabs\TLPM_64.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>TLPM_64.dll</Link>
    </Content>
    <Content Include="..\ThorLabs\ThorLabs\TLPMX_64.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>TLPMX_64.dll</Link>
