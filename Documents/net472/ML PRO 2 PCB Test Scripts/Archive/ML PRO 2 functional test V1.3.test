#20: Range finder RIGHT side
CHECK THAT IT READS between 120-145
COMMAND: MLPRO2 RRF
DELAY: 100
READLINE: MLPRO2 RRF
Range finder RIGHT side = %RRF%
PASS_FAIL: #20

#21: Range finder LEFT side
CHECK THAT IT READS between 120-145
COMMAND: MLPRO2 RRB
DELAY: 100
READLINE: MLPRO2 RRB
Range finder LEFT side = %RRB%
PASS_FAIL: #21

#22: LIGHT SENSOR LEFT side
COMMAND: MLPRO2 BSIDEWHITE 4095
CHECK THAT IT READS between 2-15
COMMAND: MLPRO2 ALSF
READLINE: MLPRO2 ALSF
LIGHT SENSOR LEFT = %ALSF%
PASS_FAIL: #22

#23: LIGHT SENSOR RIGHT side
CHECK THAT IT READS between 2-15
COMMAND: MLPRO2 ALSB
READLINE: MLPRO2 ALSB
LIGHT SENSOR RIGHT = %ALSB%
PASS_FAIL: #23
COMMAND: MLPRO2 BSIDEWHITE 0

#24: FOCUS LED
a. Check for 1 LED hot spot
IMPORTANT: You will see light reflections
b. Capture an image on the windows camera
DISPLAY: WIN_20230925_14_42_05_Pro.jpg
COMMAND: MLPRO2 FOCUSLED 4095
DELAY: 3000
PASS_FAIL: #24

#25: Save images and log file
goto C:\Users\R&D\Pictures\Camera Roll
a. create a new folder and rename it to the serial number of the MLPRO2 2
b. CUT and paste all images into the folder
go to C:\Users\R&D\Desktop\TEST_SEQUENCER V24\ML PRO 2\LOGS
c. copy and paste the test log file into the folder you just created here
goto C:\Users\R&D\Pictures\Camera Roll
PASS_FAIL: #25

#QUIT:
COMMAND: MLPRO2 FOCUSLED 0
EXE: CloseWinCam.bat
COMMAND: MLPRO2 BSIDEIR 0
COMMAND: MLPRO2 BSIDEWHITE 0
COMMAND: MLPRO2 BSIDEUV 0
COMMAND: MLPRO2 FLOOD 000000 0
COMMAND: MLPRO2 RING 000000 0
SAVE_LOG:
DISCONNECT: MLPRO2


